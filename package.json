{
  "name": "world-power-stations-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace=apps/frontend run dev",
    "dev:backend": "cd apps/backend && ./gradlew bootRun",
    "build:frontend": "npm --workspace=apps/frontend run build",
    "build:backend": "cd apps/backend && ./gradlew build -x test",
    "build": "npm run build:frontend && npm run build:backend",
    "test:frontend": "npm --workspace=apps/frontend run test",
    "test:backend": "cd apps/backend && ./gradlew test",
    "test": "npm run test:backend && npm run test:frontend",
    "typecheck": "npm --workspace=apps/frontend run typecheck",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "tf:fmt": "cd terraform && terraform fmt",
    "tf:init": "cd terraform && terraform init",
    "tf:validate": "cd terraform && terraform validate",
    "tf:plan": "cd terraform && terraform plan",
    "tf:apply": "cd terraform && terraform apply",
    "tf:destroy": "cd terraform && terraform destroy"
  }
}
